      "description": "JavaScript file download"
    },
    {
      "pattern": "\\.vbs$",
      "risk": "high",
      "type": "vbscript_file",
      "description": "VBScript file download"
    },
    {
      "pattern": "\\.(bit\\.ly|tinyurl|goo\\.gl|t\\.co|ow\\.ly|is\\.gd|buff\\.ly|adf\\.ly)",
      "risk": "medium",
      "type": "url_shortener",
      "description": "URL shortener detected (cannot see final destination)"
    },
    {
      "pattern": "\\.(login|signin|verify|secure|bank|account|wallet|payment)",
      "risk": "medium",
